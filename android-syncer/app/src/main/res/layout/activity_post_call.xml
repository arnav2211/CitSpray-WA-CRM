<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Call Summary"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Metadata Details -->
    <TextView
        android:id="@+id/callDetailsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Phone: +91 99999 99999 | Duration: 0s"
        android:textColor="#666666"
        android:textSize="14sp" />



    <!-- Call Outcome Selection Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Call Outcome"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/outcomeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="@android:drawable/btn_default" />

    <!-- Notes Input Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Conversation Summary / Notes"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/notesInput"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:background="@android:drawable/editbox_background_normal"
        android:gravity="top|left"
        android:hint="Type what you discussed with the customer..."
        android:inputType="textMultiLine"
        android:padding="8dp"
        android:textSize="14sp" />

    <!-- Action Button -->
    <Button
        android:id="@+id/saveSyncButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#002FA7"
        android:text="Save &amp; Sync to CRM"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
